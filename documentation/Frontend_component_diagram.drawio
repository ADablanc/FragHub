<diagram name="3 · Écran de réglages" id="f-settings">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="2339" background="#FFFFFF" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="f-settings-x1" value="FragHub — front-end : écran de réglages et lancement d'un run" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#263238;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="34" as="geometry" /></mxCell>
<mxCell id="f-settings-x2" value="app/app.vue et ses six onglets (app/components/*Tab.vue) · état du code au 13 novembre 2026 (soir)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#607D8B;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="20" as="geometry" /></mxCell>
<mxCell id="f-settings-x3" value="&lt;b&gt;Coquille et lancement&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-settings-app" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="330" height="228" as="geometry" /></mxCell>
<mxCell id="f-settings-app-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-app"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-app-h" value="Coquille de l'écran" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-app"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-app-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;app/app.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Bandeau sombre : onglets Vuetify (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;v-tabs&lt;/span&gt; / &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;v-tabs-window&lt;/span&gt;), onglet actif dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;activeTab&lt;/span&gt; (défaut INPUT).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Interrupteur mode sombre : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;DarkReader.enable({brightness 100, contrast 90, sepia 10})&lt;/span&gt; / &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;disable()&lt;/span&gt; ; désactivé au montage.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Logo en filigrane (opacité 0,25) ; bouton START flottant en bas, message d'erreur juste au-dessus (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;v-alert&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting&lt;/span&gt; faux : cet écran ; vrai : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ProgressView&lt;/span&gt; à la place.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-app"><mxGeometry x="0" y="28" width="330" height="200" as="geometry" /></mxCell>
<mxCell id="f-settings-start" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF0FA;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="330" height="333" as="geometry" /></mxCell>
<mxCell id="f-settings-start-s" value="" style="rounded=0;html=1;fillColor=#3949AB;strokeColor=none;" vertex="1" parent="f-settings-start"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-start-h" value="START → lancement du run" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-start"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-start-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;startExecution()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;0. START grisé tant qu'un champ numérique est invalide (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;invalidFields&lt;/span&gt;) ; les noms des champs sont affichés au-dessus.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;1. &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting = true&lt;/span&gt; tout de suite : l'écran de progression s'affiche et ouvre son socket avant que le run ne commence.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;2. 500 ms plus tard : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POST http://127.0.0.1:8000/run-analysis&lt;/span&gt; avec &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt; en JSON.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#C62828&quot;&gt;✕&lt;/span&gt;&amp;nbsp;Run refusé : retour aux réglages, message du serveur affiché au-dessus de START (« FragHub server refused the run: … », détail de FastAPI mis en texte par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;serverErrorText&lt;/span&gt;) ; réponse sans JSON : code HTTP.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#C62828&quot;&gt;✕&lt;/span&gt;&amp;nbsp;Serveur injoignable : retour aux réglages, « FragHub server unreachable ». Le message est effacé au lancement suivant.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Côté Python, les paramètres sont validés par un modèle Pydantic (interrupteurs en 1.0 / 0.0).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-start"><mxGeometry x="0" y="28" width="330" height="305" as="geometry" /></mxCell>
<mxCell id="f-settings-state" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF2F4;strokeColor=#546E7A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="330" height="393" as="geometry" /></mxCell>
<mxCell id="f-settings-state-s" value="" style="rounded=0;html=1;fillColor=#546E7A;strokeColor=none;" vertex="1" parent="f-settings-state"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-state-h" value="parameters : l'état partagé du run" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#546E7A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-state"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-state-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;useState('parameters') dans app.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Un seul objet réactif, lu et écrit par tous les onglets, envoyé tel quel au back-end.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_directory&lt;/span&gt; [] · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_db_names&lt;/span&gt; {} · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;output_directory&lt;/span&gt; &quot;&quot;&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Filtres (1.0 = actif) : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;normalize_intensity&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;remove_peak_above_precursormz&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;check_minimum_peak_requiered&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_n_peaks&lt;/span&gt; 3), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reduce_peak_list&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_max_peaks&lt;/span&gt; 500), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;remove_spectrum_under_entropy_score&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_value&lt;/span&gt; 0.5), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;keep_mz_in_range&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_from_mz&lt;/span&gt; 50, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_to_mz&lt;/span&gt; 2000), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;check_minimum_of_high_peaks_requiered&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_intensity_percent&lt;/span&gt; 5, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_no_peaks&lt;/span&gt; 2).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;calculate_de_novo&lt;/span&gt; 0.0 · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;de_novo_ppm_tolerance&lt;/span&gt; 10 · sorties &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;csv&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;msp&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;mzspeclib_json&lt;/span&gt; 1.0 · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reset_updates&lt;/span&gt; 0.0 · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;write_perf_logs&lt;/span&gt; 0.0.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Chaque onglet remet ses valeurs par défaut si elles manquent (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;initDefaults&lt;/span&gt;) ; les mêmes que la ligne de commande (vérifié par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;tests/test_interface.py&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;useState('invalidFields')&lt;/span&gt; : champs dont la saisie n'est pas un nombre ; bloque START.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-state"><mxGeometry x="0" y="28" width="330" height="365" as="geometry" /></mxCell>
<mxCell id="f-settings-x4" value="&lt;b&gt;Les six onglets&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#607D8B&quot;&gt;chacun lit et écrit parameters&lt;/span&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="450" height="20" as="geometry" /></mxCell>
<mxCell id="f-settings-input" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="158" width="450" height="168" as="geometry" /></mxCell>
<mxCell id="f-settings-input-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-input"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-input-h" value="INPUT · fichiers d'entrée" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-input"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-input-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;InputTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Bouton de sélection → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electronAPI.selectFiles()&lt;/span&gt; ; les chemins complets s'ajoutent à &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_directory&lt;/span&gt; (le nom seul est affiché).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Un fichier déjà dans la liste n'est pas ajouté une deuxième fois (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;addFiles&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Par fichier : menu « base d'origine » (MoNA, GNPS, MassBank, HMDB, NIST, Respect ; défaut Unknown) → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_db_names[chemin]&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Retirer un fichier, tout effacer.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-input"><mxGeometry x="0" y="28" width="450" height="140" as="geometry" /></mxCell>
<mxCell id="f-settings-output" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="352" width="450" height="93" as="geometry" /></mxCell>
<mxCell id="f-settings-output-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-output"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-output-h" value="OUTPUT · dossier de sortie" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-output"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-output-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;OutputTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Bouton → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electronAPI.selectFolder()&lt;/span&gt; → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;output_directory&lt;/span&gt; (chemin absolu).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-output"><mxGeometry x="0" y="28" width="450" height="65" as="geometry" /></mxCell>
<mxCell id="f-settings-filters" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="471" width="450" height="153" as="geometry" /></mxCell>
<mxCell id="f-settings-filters-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-filters"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-filters-h" value="Filters · nettoyage des pics et des spectres" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-filters"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-filters-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;FiltersTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Sept filtres, dans l'ordre du moteur : chacun un interrupteur (1.0 / 0.0) et ses champs numériques (voir la carte &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Description de chaque filtre affichée à côté.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Champs numériques : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;useNumberFields&lt;/span&gt; ; virgule décimale acceptée ; saisie invalide en rouge « Number expected », jamais envoyée (voir « Champs numériques »).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-filters"><mxGeometry x="0" y="28" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="f-settings-denovo" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="450" height="123" as="geometry" /></mxCell>
<mxCell id="f-settings-denovo-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-denovo"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-denovo-h" value="De Novo · formules des fragments" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-denovo"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-denovo-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;DeNovoTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;« Calculate fragment formula » → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;calculate_de_novo&lt;/span&gt; ; « ppm tolerance » → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;de_novo_ppm_tolerance&lt;/span&gt; (défaut 10).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Tolérance : même règle que les champs de Filters (avant, une saisie invalide devenait 0 ppm).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-denovo"><mxGeometry x="0" y="28" width="450" height="95" as="geometry" /></mxCell>
<mxCell id="f-settings-formats" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="799" width="450" height="93" as="geometry" /></mxCell>
<mxCell id="f-settings-formats-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-formats"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-formats-h" value="Output settings · formats écrits" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-formats"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-formats-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;OutputSettingTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Quatre interrupteurs : CSV, MSP, JSON, mzSpecLib (JSON) → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;csv&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;msp&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;mzspeclib_json&lt;/span&gt; (tous à 1.0 par défaut).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-formats"><mxGeometry x="0" y="28" width="450" height="65" as="geometry" /></mxCell>
<mxCell id="f-settings-projects" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="918" width="450" height="153" as="geometry" /></mxCell>
<mxCell id="f-settings-projects-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-settings-projects"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-projects-h" value="Projects settings · mise à jour d'un projet" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-projects"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-projects-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;ProjectsTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;« RESET PROJECT ? » YES / NO → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reset_updates&lt;/span&gt; : cliquable seulement si &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;output_directory&lt;/span&gt; contient « FragHub » ; sinon remis de force à NO (garde-fou : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reset_updates&lt;/span&gt; vide le dossier de sortie côté back-end).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;« Write perf logs » → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;write_perf_logs&lt;/span&gt; (journal &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;PERF_LOGS&lt;/span&gt; du run).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-projects"><mxGeometry x="0" y="28" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="f-settings-x5" value="&lt;b&gt;Autour des onglets&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-settings-ipc" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FDF0E7;strokeColor=#E8590C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="158" width="330" height="138" as="geometry" /></mxCell>
<mxCell id="f-settings-ipc-s" value="" style="rounded=0;html=1;fillColor=#E8590C;strokeColor=none;" vertex="1" parent="f-settings-ipc"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-ipc-h" value="Sélections via Electron" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8590C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-ipc"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-ipc-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;window.electronAPI (preload.cjs)&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;selectFiles()&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;selectFolder()&lt;/span&gt; ouvrent les boîtes de dialogue natives du processus principal (page 2).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Les onglets INPUT et OUTPUT sont les seuls à en avoir besoin.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-ipc"><mxGeometry x="0" y="28" width="330" height="110" as="geometry" /></mxCell>
<mxCell id="f-settings-numbers" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF2F4;strokeColor=#546E7A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="322" width="330" height="243" as="geometry" /></mxCell>
<mxCell id="f-settings-numbers-s" value="" style="rounded=0;html=1;fillColor=#546E7A;strokeColor=none;" vertex="1" parent="f-settings-numbers"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-numbers-h" value="Champs numériques" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#546E7A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-numbers"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-numbers-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;composables/useNumberFields.js · utils/decimal.js&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parseDecimal&lt;/span&gt; : « 12 », « 12.5 », « 12,5 », « ,5 » acceptés ; vide, texte, « 1,234,5 », « 1.2.3 », négatif refusés (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;null&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Saisie valide : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt; mis à jour. Saisie invalide : texte gardé dans le champ, réglage laissé à sa dernière valeur valide, champ noté dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;invalidFields&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Onglet rouvert : les champs repartent des valeurs valides, plus rien n'est bloqué.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;serverErrorText&lt;/span&gt; : met en texte le &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;detail&lt;/span&gt; d'une réponse d'erreur de FastAPI (texte, ou liste champ : message).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-numbers"><mxGeometry x="0" y="28" width="330" height="215" as="geometry" /></mxCell>
<mxCell id="f-settings-backend" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FBF4E6;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="591" width="330" height="168" as="geometry" /></mxCell>
<mxCell id="f-settings-backend-s" value="" style="rounded=0;html=1;fillColor=#B7791F;strokeColor=none;" vertex="1" parent="f-settings-backend"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-settings-backend-h" value="Réception côté back-end" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-settings-backend"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-settings-backend-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;scripts/FragHub.py · POST /run-analysis&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Les mêmes noms de champs que &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt; ; le run démarre dans un fil à part et la progression part en Socket.IO (page 4).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#C62828&quot;&gt;✕&lt;/span&gt;&amp;nbsp;Champ manquant ou d'un mauvais type : réponse 422 avec la liste des champs refusés.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_db_names&lt;/span&gt; donne la base d'origine de chaque fichier quand le nom ne suffit pas.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-settings-backend"><mxGeometry x="0" y="28" width="330" height="140" as="geometry" /></mxCell>
<mxCell id="f-settings-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-settings-state" target="f-settings-input"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="f-settings-e1" value="clic START" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-settings-app" target="f-settings-start"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="f-settings-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-settings-input" target="f-settings-ipc"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="f-settings-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-settings-filters" target="f-settings-numbers"><mxGeometry relative="1" as="geometry" /></mxCell>
