<mxCell id="f-startup-x1" value="FragHub — front-end : démarrage de l'application" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#263238;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="34" as="geometry" /></mxCell>
