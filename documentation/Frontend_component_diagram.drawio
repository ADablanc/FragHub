<mxCell id="f-build-x1" value="FragHub — front-end : configuration, construction, empaquetage et tests" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#263238;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="34" as="geometry" /></mxCell>
<mxCell id="f-build-x2" value="GUI/nuxt.config.js · GUI/package.json · GUI/vitest.config.mjs · build_frontend.py · build_all.py · sync_version.py · état du code au 13 novembre 2026 (soir)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#607D8B;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="20" as="geometry" /></mxCell>
<mxCell id="f-build-x3" value="&lt;b&gt;Configuration&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="450" height="20" as="geometry" /></mxCell>
<mxCell id="f-build-nuxt" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="450" height="183" as="geometry" /></mxCell>
<mxCell id="f-build-nuxt-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-build-nuxt"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-nuxt-h" value="Configuration Nuxt" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-nuxt"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-nuxt-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/nuxt.config.js&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ssr: false&lt;/span&gt; : application 100 % côté client (une seule page).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app.baseURL '/'&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;buildAssetsDir 'assets'&lt;/span&gt; : chemins des ressources compatibles avec le protocole &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app://&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;router.options.hashMode&lt;/span&gt; ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;experimental.payloadExtraction&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;appManifest&lt;/span&gt; désactivés : Nuxt ne va plus chercher &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_payload.json&lt;/span&gt; ni &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_builds/meta.json&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Module &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;vuetify-nuxt-module&lt;/span&gt; ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;compatibilityDate 2025-07-15&lt;/span&gt; ; devtools activés.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-nuxt"><mxGeometry x="0" y="28" width="450" height="155" as="geometry" /></mxCell>
<mxCell id="f-build-package" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="450" height="198" as="geometry" /></mxCell>
<mxCell id="f-build-package-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-build-package"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-package-h" value="Paquet et dépendances" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-package"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-package-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/package.json · package-lock.json&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Nom FragHub, version 2.0.0, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main = electron/main.js&lt;/span&gt;, modules ES.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Scripts : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dev&lt;/span&gt; (nuxt dev), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;generate&lt;/span&gt; (→ .output/public), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electron&lt;/span&gt; (lance Electron sur main.js), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;build:electron&lt;/span&gt; (electron-builder), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;postinstall&lt;/span&gt; (nuxt prepare), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;test&lt;/span&gt; (vitest run).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Dépendances : electron 40, electron-builder 25, nuxt 4, vue 3.5, vuetify 4, vuetify-nuxt-module, socket.io-client 4, darkreader ; pour les tests : vitest 5, @nuxt/test-utils 4, @vue/test-utils, happy-dom.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-package"><mxGeometry x="0" y="28" width="450" height="170" as="geometry" /></mxCell>
<mxCell id="f-build-builder" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="591" width="450" height="183" as="geometry" /></mxCell>
<mxCell id="f-build-builder-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-build-builder"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-builder-h" value="Empaquetage (electron-builder)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-builder"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-builder-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/package.json · clé build&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;appId com.fraghub.app&lt;/span&gt;, sortie &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/dist_electron/&lt;/span&gt; ; fichiers embarqués : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.output/public/**&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electron/**&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;package.json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/assets/**&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;extraResources&lt;/span&gt; : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;scripts/dist/FragHub_Backend/&lt;/span&gt; → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;resources/bin/&lt;/span&gt; (l'exécutable PyInstaller du back-end, avec RDKit C++ et la base interne).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Windows : installeur NSIS, icône &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_icon.png&lt;/span&gt; ; macOS : DMG, icône &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_icon.icns&lt;/span&gt; ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npmRebuild false&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-builder"><mxGeometry x="0" y="28" width="450" height="155" as="geometry" /></mxCell>
<mxCell id="f-build-x4" value="&lt;b&gt;Construction et tests&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="450" height="20" as="geometry" /></mxCell>
<mxCell id="f-build-front" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF0FA;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="158" width="450" height="123" as="geometry" /></mxCell>
<mxCell id="f-build-front-s" value="" style="rounded=0;html=1;fillColor=#3949AB;strokeColor=none;" vertex="1" parent="f-build-front"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-front-h" value="build_frontend.py" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-front"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-front-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;racine du dépôt&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npm install&lt;/span&gt; si &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/node_modules&lt;/span&gt; manque, puis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npm run generate&lt;/span&gt; → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/.output/public&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Option &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--dry-run&lt;/span&gt; : affiche les commandes sans rien lancer. Outils communs dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;build_utils.py&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-front"><mxGeometry x="0" y="28" width="450" height="95" as="geometry" /></mxCell>
<mxCell id="f-build-all" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF0FA;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="307" width="450" height="138" as="geometry" /></mxCell>
<mxCell id="f-build-all-s" value="" style="rounded=0;html=1;fillColor=#3949AB;strokeColor=none;" vertex="1" parent="f-build-all"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-all-h" value="build_all.py" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-all"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-all-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;racine du dépôt&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Back-end (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;build_backend.py&lt;/span&gt; : maturin + PyInstaller), front-end (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;build_frontend.py&lt;/span&gt;), puis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npm run build:electron&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Options : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--skip-rust&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--skip-backend&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--skip-frontend&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--no-installer&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--dry-run&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Chaque script appelle d'abord &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;sync_version.py&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-all"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-build-version" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="471" width="450" height="108" as="geometry" /></mxCell>
<mxCell id="f-build-version-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-build-version"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-version-h" value="sync_version.py" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-version"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-version-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;racine du dépôt&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Recopie la version du &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;pyproject.toml&lt;/span&gt; racine (2.0.0) dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/package.json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;package-lock.json&lt;/span&gt;, les fichiers Cargo, le README et la documentation ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;--check&lt;/span&gt; vérifie sans écrire.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-version"><mxGeometry x="0" y="28" width="450" height="80" as="geometry" /></mxCell>
<mxCell id="f-build-dev" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="605" width="450" height="153" as="geometry" /></mxCell>
<mxCell id="f-build-dev-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-build-dev"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-dev-h" value="En développement" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-dev"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-dev-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;npm run generate puis npm run electron&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Electron charge toujours &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.output/public&lt;/span&gt; via &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app://&lt;/span&gt; : après une modification de la page, relancer &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npm run generate&lt;/span&gt; (pas de rechargement à chaud).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Le back-end lancé est l'exécutable PyInstaller de &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;scripts/dist/FragHub_Backend/&lt;/span&gt;, pas &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub.py&lt;/span&gt; : le reconstruire après une modification du back-end.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-dev"><mxGeometry x="0" y="28" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="f-build-tests" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF4EA;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="784" width="450" height="273" as="geometry" /></mxCell>
<mxCell id="f-build-tests-s" value="" style="rounded=0;html=1;fillColor=#2E7D32;strokeColor=none;" vertex="1" parent="f-build-tests"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-tests-h" value="Tests de l'interface (Vitest)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-tests"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-tests-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/tests/ · GUI/vitest.config.mjs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;npm test&lt;/span&gt; dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/&lt;/span&gt;, ou &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;python run_tests.py --gui&lt;/span&gt; à la racine (voir &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;TESTS.md&lt;/span&gt;) ; quelques secondes.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Environnement &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;nuxt&lt;/span&gt; de &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;@nuxt/test-utils&lt;/span&gt; : chaque composant monté avec Vuetify dans un faux navigateur (happy-dom) ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;tests/setup.js&lt;/span&gt; démonte les composants après chaque test.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Sans Electron ni serveur : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;window.electronAPI&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;fetch&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;socket.io-client&lt;/span&gt; remplacés par des faux.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;onglets.test.js&lt;/span&gt; (chaque onglet), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progression.test.js&lt;/span&gt; (messages Socket.IO rejoués), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;application.test.js&lt;/span&gt; (START, erreurs), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;decimal.test.js&lt;/span&gt; (nombres saisis) ; outils dans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;outils.js&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;tests/test_interface.py&lt;/span&gt; (pytest) : réglages de l'interface = champs attendus par le serveur, mêmes défauts que la ligne de commande.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Non testé : Electron (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt;).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-tests"><mxGeometry x="0" y="28" width="450" height="245" as="geometry" /></mxCell>
<mxCell id="f-build-x5" value="&lt;b&gt;Fichiers&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1050" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-build-tree" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="158" width="330" height="273" as="geometry" /></mxCell>
<mxCell id="f-build-tree-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-build-tree"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-build-tree-h" value="Arborescence de GUI/" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-build-tree"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-build-tree-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;fichiers versionnés&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/app.vue&lt;/span&gt; · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/components/&lt;/span&gt; : InputTab, OutputTab, FiltersTab, DeNovoTab, OutputSettingTab, ProjectsTab, ProgressView, ActiveProgress.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/composables/useNumberFields.js&lt;/span&gt; · &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/utils/decimal.js&lt;/span&gt; : champs numériques, lecture des nombres et des erreurs du serveur.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/assets/&lt;/span&gt; : FragHub_icon.png / .ico / .icns, directory.png, files_icon.png.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electron/&lt;/span&gt; : main.js, preload.cjs, Splash.html.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;tests/&lt;/span&gt; : tests Vitest ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;vitest.config.mjs&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;nuxt.config.js&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;package.json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;package-lock.json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;tsconfig.json&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Générés, non versionnés : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.nuxt/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.output/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;node_modules/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dist_electron/&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-build-tree"><mxGeometry x="0" y="28" width="330" height="245" as="geometry" /></mxCell>
<mxCell id="f-build-e0" value="appelé par" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-build-front" target="f-build-all"><mxGeometry relative="1" as="geometry" /></mxCell>
