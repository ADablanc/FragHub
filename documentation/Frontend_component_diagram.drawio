        <mxCell id="f-startup-s2-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;startPythonServer&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Exécutable &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_Backend&lt;/span&gt; : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;resources/bin/&lt;/span&gt; une fois installé, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;scripts/dist/FragHub_Backend/&lt;/span&gt; en développement ; droits d'exécution forcés hors Windows.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Introuvable : erreur dans la console seulement ; l'écran affichera « Backend unreachable » au bout d'une minute.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s2">
