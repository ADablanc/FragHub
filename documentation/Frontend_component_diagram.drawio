<mxCell id="f-progress-report-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;report_&lt;date&gt;.html dans le dossier de sortie&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Produit par le back-end à la fin du run (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;report.rs&lt;/span&gt;) ; servi par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /report?path=&lt;/span&gt; et affiché dans l'iframe de l'onglet HTML RESULT.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-report"><mxGeometry x="0" y="28" width="330" height="80" as="geometry" /></mxCell>
