        <mxCell id="f-startup-s4-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;waitForBackend&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /health&lt;/span&gt; toutes les secondes, 60 essais au plus.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#C62828&quot;&gt;✕&amp;nbsp;Échec : « Backend unreachable. Please restart. »&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s4">
