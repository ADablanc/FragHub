        <mxCell id="f-interface-t3-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;FiltersTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Un interrupteur et ses seuils par filtre, avec une description ; virgule décimale acceptée.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;normalize_intensity&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;remove_peak_above_precursormz&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;check_minimum_peak_requiered&lt;/span&gt; (3 pics), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reduce_peak_list&lt;/span&gt; (500 pics)&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;remove_spectrum_under_entropy_score&lt;/span&gt; (0.5)&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;keep_mz_in_range&lt;/span&gt; (50 à 2000)&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;check_minimum_of_high_peaks_requiered&lt;/span&gt; (5 %, 2 pics)&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-interface-t3">
