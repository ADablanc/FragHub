        <mxCell id="f-interface-app-h" value="Racine de l'interface" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-interface-app">
          <mxGeometry x="0" y="0" width="1480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-app-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;app/app.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Hors run (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting&lt;/span&gt; faux) : bandeau INPUT · OUTPUT · Filters · De Novo · Output settings · Projects settings, et bouton START. Pendant un run : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ProgressView&lt;/span&gt; à la place.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Crée &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt; avec toutes les valeurs par défaut ; interrupteur de mode sombre (bibliothèque DarkReader, appliquée à toute la page).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-interface-app">
