        <mxCell id="f-overview-preload-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/electron/preload.cjs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Expose à l'interface &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;window.electronAPI.selectFiles()&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;selectFolder()&lt;/span&gt;, sans lui donner accès au reste du système.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Ces appels deviennent les messages IPC &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dialog:openFiles&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dialog:openFolder&lt;/span&gt;, traités par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-overview-preload">
