          <mxGeometry x="0" y="14.0" width="400" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="f-overview-splash-h" value="Fenêtre de démarrage" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-overview-splash">
          <mxGeometry x="0" y="0" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-overview-splash-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/electron/Splash.html&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Petite fenêtre transparente, sans cadre, toujours devant : logo, roue qui tourne, message.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Le message (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;#message&lt;/span&gt;) est réécrit par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt; à chaque étape (téléchargement de la base, chargement, erreur).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-overview-splash">
