        <mxCell id="f-overview-main-h" value="Chef d'orchestre de l'application" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-overview-main">
          <mxGeometry x="0" y="0" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-overview-main-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;GUI/electron/main.js&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Point d'entrée de l'application (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;&quot;main&quot;&lt;/span&gt; de &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;package.json&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Ouvre la fenêtre de démarrage, lance le back-end, prépare la fenêtre principale et ne la montre que quand tout est prêt.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Protocole &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app://&lt;/span&gt; : sert à la fenêtre les fichiers générés par Nuxt (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.output/public/&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Boîtes de dialogue fichiers et dossier, demandées par l'interface (IPC).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;À la fermeture : arrête le back-end.&lt;/div&gt;&lt;div style=&quot;color:#3949AB;font-weight:bold&quot;&gt;Détail du démarrage : page 2&amp;nbsp;→&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-overview-main">
          <mxGeometry x="0" y="28" width="400" height="166" as="geometry" />
        </mxCell>
        <mxCell id="f-overview-splash" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1">
