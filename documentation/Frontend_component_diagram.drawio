          <mxGeometry x="0" y="0" width="470" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-start-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;app.vue · startExecution&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Passe &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting&lt;/span&gt; à vrai (le suivi s'affiche et se connecte), puis 0,5 s plus tard envoie &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;parameters&lt;/span&gt; : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POST /run-analysis&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Refus ou serveur injoignable : retour aux onglets (erreur dans la console).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-interface-start">
          <mxGeometry x="0" y="28" width="470" height="76" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-auto-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.16;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-interface-state" target="f-interface-start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-pv" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="520" height="164" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-pv-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-interface-pv">
          <mxGeometry x="0" y="14.0" width="520" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-pv-h" value="Suivi du run" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-interface-pv">
          <mxGeometry x="0" y="0" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-pv-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;ProgressView.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Se connecte à Socket.IO (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;127.0.0.1:8000&lt;/span&gt;) dès son affichage.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;step&lt;/span&gt; : titre d'étape dans le journal ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;deletion&lt;/span&gt; : spectres supprimés, en rouge ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;total_items&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progress&lt;/span&gt; : nouvelle tâche et avancement (les messages d'une tâche déjà dépassée sont ignorés) ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;completion&lt;/span&gt; : message final et chemin du rapport.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Onglet EXECUTION REPORT (journal) et, à la fin, onglet du rapport HTML, affiché dans un cadre depuis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /report?path=…&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;STOP : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /stop-analysis&lt;/span&gt; ; FINISH : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting&lt;/span&gt; faux, retour aux onglets.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-interface-pv">
          <mxGeometry x="0" y="28" width="520" height="136" as="geometry" />
        </mxCell>
