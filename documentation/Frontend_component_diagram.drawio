<mxCell id="f-progress-x2" value="app/components/ProgressView.vue · ActiveProgress.vue · état du code au 13 novembre 2026 (soir)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#607D8B;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="20" as="geometry" /></mxCell>
<mxCell id="f-progress-x3" value="&lt;b&gt;Du premier message à la fin du run&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="450" height="20" as="geometry" /></mxCell>
<mxCell id="f-progress-socket" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5EAF7;strokeColor=#8E24AA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="158" width="450" height="138" as="geometry" /></mxCell>
<mxCell id="f-progress-socket-s" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="f-progress-socket"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-socket-h" value="Connexion" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#8E24AA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-socket"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-socket-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;ProgressView.vue · socket.io-client&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;io('http://127.0.0.1:8000')&lt;/span&gt; à la création du composant (donc avant le &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POST /run-analysis&lt;/span&gt;, page 3) ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;socket.disconnect()&lt;/span&gt; à sa destruction.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Horloge : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;now&lt;/span&gt; rafraîchi chaque seconde pour le temps écoulé, la vitesse et l'ETA.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-socket"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-progress-task" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5EAF7;strokeColor=#8E24AA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="322" width="450" height="198" as="geometry" /></mxCell>
<mxCell id="f-progress-task-s" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="f-progress-task"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-task-h" value="Une tâche = une barre" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#8E24AA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-task"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-task-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;startTask(meta) · checkTaskFinished()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Le back-end numérote les tâches ; chaque message porte &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;{task, total, prefix, item_type, started}&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;total_items&lt;/span&gt; ou un &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progress&lt;/span&gt; d'une tâche nouvelle : la tâche précédente est figée en encadré vert si elle n'était pas finie, puis compteur à zéro, total et heure de début repris du message.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Message d'une tâche déjà dépassée : ignoré ; message de début perdu (reconnexion du socket) : rattrapé grâce aux informations jointes.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Quand &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;value ≥ total&lt;/span&gt; : encadré vert « terminé » ajouté au journal (nom, n sur total, temps, vitesse), une seule fois par tâche.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-task"><mxGeometry x="0" y="28" width="450" height="170" as="geometry" /></mxCell>
<mxCell id="f-progress-log" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5EAF7;strokeColor=#8E24AA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="546" width="450" height="138" as="geometry" /></mxCell>
<mxCell id="f-progress-log-s" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="f-progress-log"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-log-h" value="Journal affiché" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#8E24AA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-log"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-log-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;logs[] · types step, deletion, progress_finished&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;step&lt;/span&gt; : titre centré en bleu ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;deletion&lt;/span&gt; : texte rouge (spectres supprimés et motif) ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progress_finished&lt;/span&gt; : encadré vert avec barre à 100 %.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Défilement automatique vers le bas à chaque ajout (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;scrollToBottom&lt;/span&gt;).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-log"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-progress-active" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5EAF7;strokeColor=#8E24AA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="710" width="450" height="138" as="geometry" /></mxCell>
<mxCell id="f-progress-active-s" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="f-progress-active"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-active-h" value="Barre en cours" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#8E24AA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-active"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-active-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;ActiveProgress.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Reçoit en propriétés : libellé (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;prefix&lt;/span&gt;, deux-points finaux retirés), pourcentage, n sur total, type d'élément, temps écoulé, ETA, vitesse.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Barre animée (pulsation) ; temps affiché avec millisecondes sous 10 s.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-active"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-progress-end" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#F5EAF7;strokeColor=#8E24AA;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="874" width="450" height="153" as="geometry" /></mxCell>
<mxCell id="f-progress-end-s" value="" style="rounded=0;html=1;fillColor=#8E24AA;strokeColor=none;" vertex="1" parent="f-progress-end"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-end-h" value="Fin du run" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#8E24AA;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-end"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-end-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;socket.on('completion')&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Texte simple (ancien back-end) ou &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;{message, report_path}&lt;/span&gt; : barre à 100 %, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isFinished&lt;/span&gt;, message final en grand.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Si &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;report_path&lt;/span&gt; : onglet HTML RESULT (clignotant tant qu'il n'est pas ouvert) → iframe sur &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /report?path=…&lt;/span&gt; ; on ne bascule pas automatiquement.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;CLOSE REPORT → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isExecuting = false&lt;/span&gt; : retour aux réglages.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-end"><mxGeometry x="0" y="28" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="f-progress-x4" value="&lt;b&gt;Commandes et calculs&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-progress-stop" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FDF0E7;strokeColor=#E8590C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="330" height="168" as="geometry" /></mxCell>
<mxCell id="f-progress-stop-s" value="" style="rounded=0;html=1;fillColor=#E8590C;strokeColor=none;" vertex="1" parent="f-progress-stop"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-stop-h" value="STOP PROCESS" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8590C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-stop"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-stop-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;stopProcess()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;isStopping = true&lt;/span&gt; (bouton « STOPPING… »), puis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /stop-analysis&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Le back-end lève l'indicateur partagé du moteur Rust : arrêt en moins d'une seconde et dossier de sortie remis comme avant le run (diagramme back-end : stop.rs, output_guard.rs). Le message &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;completion&lt;/span&gt; arrive ensuite.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-stop"><mxGeometry x="0" y="28" width="330" height="140" as="geometry" /></mxCell>
<mxCell id="f-progress-maths" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF2F4;strokeColor=#546E7A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="330" height="168" as="geometry" /></mxCell>
<mxCell id="f-progress-maths-s" value="" style="rounded=0;html=1;fillColor=#546E7A;strokeColor=none;" vertex="1" parent="f-progress-maths"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-progress-maths-h" value="Calculs affichés" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#546E7A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-progress-maths"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-progress-maths-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;computed() de ProgressView.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progressPercent&lt;/span&gt; = valeur / total, plafonné à 100 ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;elapsedSec&lt;/span&gt; = now − startTime.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;speedVal&lt;/span&gt; = valeur / temps écoulé (0 sous 0,1 s tant que la tâche n'est pas finie) ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;etaSec&lt;/span&gt; = restant / vitesse.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;formatTime&lt;/span&gt; : hh:mm:ss, avec millisecondes sous 10 s.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-progress-maths"><mxGeometry x="0" y="28" width="330" height="140" as="geometry" /></mxCell>
<mxCell id="f-progress-x5" value="&lt;b&gt;Côté back-end&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-progress-events" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FBF4E6;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="158" width="330" height="228" as="geometry" /></mxCell>
