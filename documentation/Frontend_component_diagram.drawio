        <mxCell id="f-interface-t1-h" value="INPUT" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-interface-t1">
          <mxGeometry x="0" y="0" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="f-interface-t1-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;InputTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Parcourir (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;electronAPI.selectFiles&lt;/span&gt;), retirer un fichier, tout effacer.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Pour chaque fichier, nom de sa base : MoNA, GNPS, MassBank, HMDB, NIST, Respect, ou texte libre ; « Unknown » par défaut.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_directory&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;input_db_names&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-interface-t1">
