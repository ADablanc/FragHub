<mxCell id="f-overview-x1" value="FragHub — front-end : vue d'ensemble de l'interface" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#263238;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="34" as="geometry" /></mxCell>
<mxCell id="f-overview-x2" value="Dossier GUI · Electron 40 + Nuxt 4 (Vue 3, Vuetify 4), application 100 % côté client · état du code au 13 novembre 2026 (soir)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#607D8B;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="20" as="geometry" /></mxCell>
<mxCell id="f-overview-x3" value="&lt;b&gt;Ce que voit l'utilisateur&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="20" as="geometry" /></mxCell>
