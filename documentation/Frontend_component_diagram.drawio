        <mxCell id="f-overview-srv-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;FragHub_Backend (scripts/FragHub.py)&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Lancé par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt; au démarrage, arrêté à la fermeture.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Appelé par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt; : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/health&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/database-status&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/init-data&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Appelé par l'interface : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POST /run-analysis&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/stop-analysis&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/report&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Messages Socket.IO vers &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ProgressView&lt;/span&gt; : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progress&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;total_items&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;prefix&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;item_type&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;step&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;deletion&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;completion&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;color:#607D8B;font-style:italic&quot;&gt;Diagramme du back-end : documentation/Backend_component_diagram.drawio, page 5.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-overview-srv">
