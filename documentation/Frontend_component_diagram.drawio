<mxCell id="f-startup-s0-h" value="0 · Protocole app://" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s0"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s0-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;main.js · protocol&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Déclaré privilégié avant le lancement (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;registerSchemesAsPrivileged&lt;/span&gt; : sécurisé, standard, fetch et CORS autorisés).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;protocol.handle('app')&lt;/span&gt; : l'URL &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app://-/&lt;fichier&gt;&lt;/span&gt; est servie depuis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/.output/public&lt;/span&gt; (racine &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app.getAppPath()&lt;/span&gt; empaqueté, sinon &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GUI/&lt;/span&gt;) ; paramètres et ancre retirés, vide → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;index.html&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s0"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-startup-s1" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="322" width="450" height="153" as="geometry" /></mxCell>
<mxCell id="f-startup-s1-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-startup-s1"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-s1-h" value="1 · Fenêtre de démarrage" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s1"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s1-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;createSplashWindow()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;600 × 750, sans bordure, transparente, non redimensionnable, toujours au premier plan, absente de la barre des tâches.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Charge &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;Splash.html&lt;/span&gt; ; une fois chargé, injecte le logo &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app/assets/FragHub_icon.png&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;setSplashMessage(texte)&lt;/span&gt; écrit dans l'élément &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;#message&lt;/span&gt; du splash.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s1"><mxGeometry x="0" y="28" width="450" height="125" as="geometry" /></mxCell>
<mxCell id="f-startup-s2" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FBF4E6;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="501" width="450" height="183" as="geometry" /></mxCell>
<mxCell id="f-startup-s2-s" value="" style="rounded=0;html=1;fillColor=#B7791F;strokeColor=none;" vertex="1" parent="f-startup-s2"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-s2-h" value="2 · Lancement du back-end" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#B7791F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s2"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s2-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;startPythonServer()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Exécutable &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_Backend.exe&lt;/span&gt; (Windows) ou &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_Backend&lt;/span&gt; : empaqueté → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;resources/bin/&lt;/span&gt;, sinon &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;scripts/dist/FragHub_Backend/&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Hors Windows : droits d'exécution forcés (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;chmod 755&lt;/span&gt;). &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;spawn&lt;/span&gt; avec la sortie héritée (journal du back-end dans la console d'Electron).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#C62828&quot;&gt;✕&lt;/span&gt;&amp;nbsp;Exécutable introuvable : erreur dans la console, l'application reste sur le splash (« Backend unreachable » après 60 s).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s2"><mxGeometry x="0" y="28" width="450" height="155" as="geometry" /></mxCell>
<mxCell id="f-startup-s3" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="710" width="450" height="138" as="geometry" /></mxCell>
<mxCell id="f-startup-s3-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-startup-s3"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-s3-h" value="3 · Fenêtre principale (cachée)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s3"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s3-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;createMainWindow()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;1280 × 720, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;show: false&lt;/span&gt; ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;preload.cjs&lt;/span&gt;, isolation de contexte, pas de Node, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;webSecurity: false&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Charge &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;app://-/index.html&lt;/span&gt; ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ready-to-show&lt;/span&gt; → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_nuxtReady&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Même en développement, c'est &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.output/public&lt;/span&gt; qui est chargé : pas de rechargement à chaud, il faut régénérer.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s3"><mxGeometry x="0" y="28" width="450" height="110" as="geometry" /></mxCell>
<mxCell id="f-startup-s4" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EEF0FA;strokeColor=#3949AB;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="874" width="450" height="198" as="geometry" /></mxCell>
<mxCell id="f-startup-s4-s" value="" style="rounded=0;html=1;fillColor=#3949AB;strokeColor=none;" vertex="1" parent="f-startup-s4"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-s4-h" value="4 · Attente du back-end" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s4"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s4-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;waitForBackend() · waitForDatabase()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Toutes les secondes, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /health&lt;/span&gt; ; 60 essais au plus, sinon « Backend unreachable. Please restart. ».&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Puis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /database-status&lt;/span&gt; toutes les secondes jusqu'à &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ready&lt;/span&gt; : le message du back-end (téléchargement de la base interne depuis Zenodo, vérification, installation) est affiché sur le splash ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;error&lt;/span&gt; → message et arrêt ; 30 échecs réseau → « Backend unreachable ».&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Puis « Loading internal databases… » et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;GET /init-data&lt;/span&gt; (chargement de &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;datas/&lt;/span&gt; en mémoire) → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_backendReady&lt;/span&gt; ; échec → « Error loading databases. Please restart. ».&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s4"><mxGeometry x="0" y="28" width="450" height="170" as="geometry" /></mxCell>
<mxCell id="f-startup-s5" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="1098" width="450" height="108" as="geometry" /></mxCell>
<mxCell id="f-startup-s5-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-startup-s5"><mxGeometry x="0" y="14.0" width="450" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-s5-h" value="5 · Affichage" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-s5"><mxGeometry x="0" y="0" width="450" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-s5-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;maybeShowMain()&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Appelé par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;ready-to-show&lt;/span&gt; et par la fin de l'attente : dès que &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_nuxtReady&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_backendReady&lt;/span&gt; sont vrais, ferme le splash et montre la fenêtre principale.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-s5"><mxGeometry x="0" y="28" width="450" height="80" as="geometry" /></mxCell>
<mxCell id="f-startup-x4" value="&lt;b&gt;À côté de la séquence&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-startup-ipc" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FDF0E7;strokeColor=#E8590C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="330" height="183" as="geometry" /></mxCell>
<mxCell id="f-startup-ipc-s" value="" style="rounded=0;html=1;fillColor=#E8590C;strokeColor=none;" vertex="1" parent="f-startup-ipc"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-ipc-h" value="Boîtes de dialogue (IPC)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8590C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-ipc"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-ipc-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;ipcMain.handle(…) · dialog.showOpenDialog&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dialog:openFiles&lt;/span&gt; : « Select input files », plusieurs fichiers, filtre &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;json, jsonl, csv, msp, mgf&lt;/span&gt; ; annulé → liste vide.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;dialog:openFolder&lt;/span&gt; : « Select output directory », un dossier, création possible ; annulé → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;null&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Appelées par la page via &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;window.electronAPI&lt;/span&gt; (preload.cjs).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-ipc"><mxGeometry x="0" y="28" width="330" height="155" as="geometry" /></mxCell>
<mxCell id="f-startup-quit" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E8F0FA;strokeColor=#1565C0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="367" width="330" height="93" as="geometry" /></mxCell>
<mxCell id="f-startup-quit-s" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="f-startup-quit"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-quit-h" value="Fermeture" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-quit"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-quit-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;app.on('will-quit')&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Tue le processus back-end (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;pythonProcess.kill()&lt;/span&gt;) : pas de serveur orphelin sur le port 8000.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-quit"><mxGeometry x="0" y="28" width="330" height="65" as="geometry" /></mxCell>
<mxCell id="f-startup-browser" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="330" height="153" as="geometry" /></mxCell>
<mxCell id="f-startup-browser-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="f-startup-browser"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-browser-h" value="Hors Electron (navigateur seul)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-browser"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-browser-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;InputTab.vue · OutputTab.vue&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Sans &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;window.electronAPI&lt;/span&gt; : l'onglet INPUT utilise un &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;&lt;input type=&quot;file&quot;&gt;&lt;/span&gt; caché et ne connaît que les noms des fichiers ; l'onglet OUTPUT ne peut rien choisir (avertissement console).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Mode de secours pour le développement de la page, pas un mode d'emploi.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-browser"><mxGeometry x="0" y="28" width="330" height="125" as="geometry" /></mxCell>
<mxCell id="f-startup-x5" value="&lt;b&gt;Fichier affiché&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#455A64;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="130" width="330" height="20" as="geometry" /></mxCell>
<mxCell id="f-startup-splash" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="158" width="330" height="198" as="geometry" /></mxCell>
<mxCell id="f-startup-splash-s" value="" style="rounded=0;html=1;fillColor=#37474F;strokeColor=none;" vertex="1" parent="f-startup-splash"><mxGeometry x="0" y="14.0" width="330" height="14.0" as="geometry" /></mxCell>
<mxCell id="f-startup-splash-h" value="Écran de démarrage" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="f-startup-splash"><mxGeometry x="0" y="0" width="330" height="28" as="geometry" /></mxCell>
<mxCell id="f-startup-splash-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;electron/Splash.html&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Trois éléments : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;#logo&lt;/span&gt; (400 px, pulsation), roue &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.spinner&lt;/span&gt; (même dessin que le &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;v-progress-circular&lt;/span&gt; de Vuetify), &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;#message&lt;/span&gt; sur fond blanc translucide.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Fond transparent, fenêtre déplaçable (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;-webkit-app-region: drag&lt;/span&gt;), texte non sélectionnable.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;&lt;span style=&quot;color:#607D8B&quot;&gt;↳&lt;/span&gt;&amp;nbsp;Le logo et les messages sont injectés par &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main.js&lt;/span&gt; (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;executeJavaScript&lt;/span&gt;) : le fichier n'a aucune logique.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="f-startup-splash"><mxGeometry x="0" y="28" width="330" height="170" as="geometry" /></mxCell>
<mxCell id="f-startup-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-startup-s0" target="f-startup-s1"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="f-startup-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-startup-s1" target="f-startup-s2"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="f-startup-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-startup-s2" target="f-startup-s3"><mxGeometry relative="1" as="geometry" /></mxCell>
