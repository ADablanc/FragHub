        <mxCell id="p-chemistry-dup-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;duplicatas_remover.rs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Clé (SPLASH, InChIKey) : garde le spectre aux métadonnées les plus longues ; ses champs vides sont complétés par ceux de ses doublons.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Bases d'origine des doublons retenues pour le rapport (UpSet).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#C62828&quot;&gt;✕&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;duplicatas_removed.csv&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-chemistry-dup">
          <mxGeometry x="0" y="28" width="560" height="91" as="geometry" />
        </mxCell>
