        <mxCell id="p-reading-disp-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="p-reading-disp">
          <mxGeometry x="0" y="14.0" width="760" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-disp-h" value="Aiguillage par format" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-reading-disp">
          <mxGeometry x="0" y="0" width="760" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-disp-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;parsers/dispatcher.rs · parsing_to_dict_processing&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Trie les fichiers d'entrée par extension, sans tenir compte des majuscules : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.json&lt;/span&gt; / &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.jsonl&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.msp&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.mgf&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;.csv&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Pour chaque fichier : lecteur (découpe en spectres bruts), puis parseur (métadonnées + pics), en parallèle sur tous les cœurs.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;DATABASE_NAME&lt;/span&gt; : nom de base donné par l'interface pour ce fichier, sinon « Unknown ».&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;STATE&lt;/span&gt; : table des clés (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;key_to_convert.csv&lt;/span&gt;)&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-reading-disp">
          <mxGeometry x="0" y="28" width="760" height="91" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-fmt0" value="&lt;b&gt;MSP&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E6F4F2;strokeColor=#00897B;fontColor=#263238;fontSize=11;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150.0" y="279" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=-0.2631578947368421;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-reading-disp" target="p-reading-fmt0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-lmsp" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="339" width="360" height="119" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-lmsp-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="p-reading-lmsp">
          <mxGeometry x="0" y="14.0" width="360" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-lmsp-h" value="Lecteur MSP" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-reading-lmsp">
          <mxGeometry x="0" y="0" width="360" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-lmsp-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;loaders/msp_loader.rs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Regroupe les blocs de lignes séparés par une ligne vide en spectres.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Un bloc qui ne contient que des pics est la suite du spectre précédent (MoNA : lignes vides entre les pics).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-reading-lmsp">
          <mxGeometry x="0" y="28" width="360" height="91" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-pmsp" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="488" width="360" height="134" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-pmsp-s" value="" style="rounded=0;html=1;fillColor=#00897B;strokeColor=none;" vertex="1" parent="p-reading-pmsp">
          <mxGeometry x="0" y="14.0" width="360" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-pmsp-h" value="Parseur MSP" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-reading-pmsp">
          <mxGeometry x="0" y="0" width="360" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-pmsp-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;parsers/msp_parser.rs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Lignes &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;CLÉ: valeur&lt;/span&gt;, puis les pics : un par ligne (espace, tabulation ou « : »), ou plusieurs par ligne au format NIST (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;85 999; 86 23;&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Champ &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;Comments&lt;/span&gt; de MoNA (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;&quot;clé=valeur&quot;&lt;/span&gt;) découpé en champs ; virgule décimale acceptée.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-reading-pmsp">
