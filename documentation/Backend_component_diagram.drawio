        <mxCell id="p-overview-out-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;CSV/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;MSP/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;JSON/&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;mzSpecLib/&lt;/span&gt;, chacun en &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POS/&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;NEG/&lt;/span&gt; : un fichier par bibliothèque.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;DELETED_SPECTRUMS/&lt;/span&gt; : un CSV par motif de suppression.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;updates.json&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;report_&amp;lt;date&amp;gt;.html&lt;/span&gt;.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-overview-out">
