        <mxCell id="p-python-gui-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Démarre l'exécutable du back-end, attend &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/health&lt;/span&gt;, puis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/database-status&lt;/span&gt; et &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;/init-data&lt;/span&gt; avant d'afficher la fenêtre.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Lance un run, affiche sa progression, peut l'arrêter.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-python-gui">
          <mxGeometry x="0" y="28" width="300" height="91" as="geometry" />
        </mxCell>
        <mxCell id="p-python-srv" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#FBF4E6;strokeColor=#B7791F;strokeWidth=1.5;" vertex="1" parent="1">
