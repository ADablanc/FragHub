        <mxCell id="p-reading-disp" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#E6F4F2;strokeColor=#00897B;strokeWidth=1.5;" vertex="1" parent="1">
