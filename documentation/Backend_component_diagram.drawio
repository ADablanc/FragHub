        <mxCell id="p-chemistry-amc-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;adduct_mass_calculator.rs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Masses monoisotopiques des éléments (NIST).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;m/z = (n · M + Δm) / z, avec n et z lus dans l'adduit (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;[2M+H]+&lt;/span&gt; → n = 2, z = 1).&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-chemistry-amc">
