        <mxCell id="p-chemistry-rn-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;rdkit_native/mod.rs · run_parallel&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Toutes les molécules sur tous les cœurs (threads), dans un seul processus, sans Python.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Une molécule sans « . » ne dépend ni de l'adduit ni du m/z : calculée une seule fois.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-chemistry-rn">
          <mxGeometry x="0" y="28" width="560" height="61" as="geometry" />
