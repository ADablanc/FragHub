        </mxCell>
        <mxCell id="p-chemistry-rn" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF4EA;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="296" width="560" height="89" as="geometry" />
