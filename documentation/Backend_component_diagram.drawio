        <mxCell id="p-chemistry-dup-h" value="6.7 · Doublons" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#3949AB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-chemistry-dup">
