        <mxCell id="p-cleaning-params-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Chaque filtre (option) a son interrupteur et son seuil, choisis dans l'interface ou en ligne de commande.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Valeurs par défaut du mode CLI :&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;keep_mz_in_range_from_mz&lt;/span&gt; 50, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;…_to_mz&lt;/span&gt; 2000&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reduce_peak_list_max_peaks&lt;/span&gt; 500&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;check_minimum_peak_requiered_n_peaks&lt;/span&gt; 3&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;…_high_peaks_requiered_no_peaks&lt;/span&gt; 2&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;…_high_peaks_requiered_intensity_percent&lt;/span&gt; 5&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;remove_spectrum_under_entropy_score_value&lt;/span&gt; 0.5&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px;color:#607D8B&quot;&gt;↳&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;de_novo_ppm_tolerance&lt;/span&gt; 10&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-cleaning-params">
