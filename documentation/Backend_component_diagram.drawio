        <mxCell id="p-python-lib-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;scripts/fraghub_rust/src/lib.rs · #[pymodule] fraghub_rust&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;main_orchestrator&lt;/span&gt; : un run complet (vue d'ensemble, page 1).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;load_internal_databases&lt;/span&gt; : remplit &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;STATE&lt;/span&gt; depuis &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;datas/&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;init_project&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reset_updates&lt;/span&gt; : dossier de sortie, remise à zéro des mises à jour.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;request_stop&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;reset_stop&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;install_ctrl_c_handler&lt;/span&gt; : arrêt.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;guard_output_file&lt;/span&gt; : protection d'un fichier écrit par Python (mzSpecLib).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;renormalize_internal_database&lt;/span&gt; : outil de maintenance de la base (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;database_renormalization.rs&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;native_exact_mass&lt;/span&gt; : vérification d'une masse calculée par RDKit C++.&lt;/div&gt;&lt;div style=&quot;color:#3949AB;font-weight:bold&quot;&gt;Pipeline : page 1&amp;nbsp;→&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-python-lib">
