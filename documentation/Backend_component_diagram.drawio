        <mxCell id="p-overview-s65-h" value="6.5 · Masse et adduit" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-overview-s65">
