          <mxGeometry x="40" y="407" width="560" height="164" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-shim-s" value="" style="rounded=0;html=1;fillColor=#2E7D32;strokeColor=none;" vertex="1" parent="p-chemistry-shim">
