        <mxCell id="p-reading-raw-h" value="Renommage des champs (commun aux quatre parseurs)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#00897B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-reading-raw">
          <mxGeometry x="0" y="0" width="760" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-raw-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;parsers/raw_metadata.rs&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Chaque champ brut prend sa clé FragHub (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;key_to_convert.csv&lt;/span&gt;), dans l'ordre du fichier : le résultat ne dépend pas du hasard.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Unité portée par le nom du champ gardée : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;RTINSECONDS=70.99&lt;/span&gt; → &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;RT = 70.99 s&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Énergies numérotées (Spectraverse : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;COLLISION_ENERGY_1&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_2&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;_3&lt;/span&gt;) réunies en une valeur (rampe ou paliers).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FILENAME&lt;/span&gt; : fichier d'origine donné par le spectre (MSnLib, GNPS), sinon le fichier d'entrée ; le fichier d'entrée reste connu en interne.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-reading-raw">
          <mxGeometry x="0" y="28" width="760" height="91" as="geometry" />
        </mxCell>
        <mxCell id="p-reading-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#455A64;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#455A64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=-0.2631578947368421;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p-reading-pmsp" target="p-reading-raw">
