        <mxCell id="p-reading-t1" value="Étape 1 — lecture des fichiers d'entrée" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontColor=#263238;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
