        </mxCell>
        <mxCell id="p-chemistry-shim-h" value="Une molécule (RDKit C++ 2026.09.1)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-chemistry-shim">
          <mxGeometry x="0" y="0" width="560" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-shim-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;rdkit_native/shim.cc · process_single&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;1. Lecture de l'InChI, sinon du SMILES.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;2. Dessalage : garde le composant dont le m/z attendu pour l'adduit correspond au m/z précurseur.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;3. Neutralisation de la charge.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;4. InChI et InChIKey standard, formule, masses de cette molécule.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;5. SMILES : tautomère canonique, stéréochimie gardée ; s'il change l'InChI, SMILES de l'étape 3.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-chemistry-shim">
          <mxGeometry x="0" y="28" width="560" height="136" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-mz" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#EAF4EA;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="593" width="560" height="149" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-mz-s" value="" style="rounded=0;html=1;fillColor=#2E7D32;strokeColor=none;" vertex="1" parent="p-chemistry-mz">
          <mxGeometry x="0" y="14.0" width="560" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-mz-h" value="6.5 · Masse et adduit" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-chemistry-mz">
          <mxGeometry x="0" y="0" width="560" height="28" as="geometry" />
