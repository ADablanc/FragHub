          <mxGeometry x="0" y="14.0" width="560" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="p-chemistry-rn-h" value="Calcul en parallèle" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-chemistry-rn">
          <mxGeometry x="0" y="0" width="560" height="28" as="geometry" />
