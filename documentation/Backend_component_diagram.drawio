        <mxCell id="p-python-srv-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;scripts/FragHub.py&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;FastAPI (HTTP) + Socket.IO (messages en continu) sur &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;127.0.0.1:8000&lt;/span&gt; ; exécutable PyInstaller &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub_Backend&lt;/span&gt;.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Un run tourne en tâche de fond ; les rappels du moteur Rust deviennent des messages Socket.IO.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-python-srv">
