        <mxCell id="p-reading-t2" value="Branche Rust_FragHub · scripts/fraghub_rust/src · état du code au 12 novembre 2026 · parsers/ et loaders/" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#607D8B;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1">
