        <mxCell id="p-python-sio-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;progress&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;total_items&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;prefix&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;item_type&lt;/span&gt;, &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;step&lt;/span&gt; : barre de progression et étape en cours.&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;deletion&lt;/span&gt; : spectres supprimés par motif ; &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;completion&lt;/span&gt; : fin du run et chemin du rapport.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-python-sio">
