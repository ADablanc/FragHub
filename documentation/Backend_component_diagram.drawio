        </mxCell>
        <mxCell id="p-python-gui-h" value="Interface Electron (GUI/)" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#37474F;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="p-python-gui">
          <mxGeometry x="0" y="0" width="300" height="28" as="geometry" />
