        <mxCell id="p-overview-ui-t" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-weight:bold;color:#263238&quot;&gt;scripts/FragHub.py&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Application : serveur FastAPI + Socket.IO, appelé par l'interface Electron (&lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;POST /run-analysis&lt;/span&gt;).&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Ligne de commande : &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;FragHub.py --cli …&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:11px;text-indent:-11px&quot;&gt;•&amp;nbsp;Appelle &lt;span style=&quot;font-family:Courier New,monospace&quot;&gt;fraghub_rust.main_orchestrator(…)&lt;/span&gt; et relaie la progression à l'écran.&lt;/div&gt;&lt;div style=&quot;color:#3949AB;font-weight:bold&quot;&gt;Détail : page 5&amp;nbsp;→&lt;/div&gt;&lt;/div&gt;" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=11;spacingRight=8;spacingTop=4;fontSize=11;fontColor=#263238;fontFamily=Helvetica;" vertex="1" parent="p-overview-ui">
