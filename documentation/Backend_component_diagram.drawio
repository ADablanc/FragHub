  <diagram name="2 · Lecture des fichiers" id="p-reading">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="2339" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
